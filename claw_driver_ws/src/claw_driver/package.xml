<?xml version="1.0"?>
<package format="3">
  <name>claw_driver</name>
  <version>0.0.0</version>
  <description>ROS 2 Python package for claw driver action server/client skeleton</description>

  <maintainer email="amrutha@example.com">Amrutha</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>action_msgs</depend>
  <depend>claw_driver_interfaces</depend>
  <exec_depend>rosidl_default_runtime</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
