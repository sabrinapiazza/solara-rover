[Unit]
Description=Solara MLX90640 Thermal Camera Sensor
After=network.target mosquitto.service
Requires=mosquitto.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/solara-rover/env_data/sensors
ExecStart=/usr/bin/python3 /home/ubuntu/solara-rover/env_data/sensors/thermal.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target